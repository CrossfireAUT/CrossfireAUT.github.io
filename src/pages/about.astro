---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, AUTHOR } from '../consts';
---

<BaseLayout title="About" description={`About ${SITE_TITLE} and ${AUTHOR}.`}>
  <div class="container wrap prose">
    <h1>About</h1>
    <p>
      Hi, I'm a sysadmin from Austria. For about ten years I've kept servers, networks and users
      running, held together by Ansible. {SITE_TITLE} is where I write down the security side of
      that job: hardening, monitoring, Microsoft 365 settings nobody chose, and what I learn from incidents.
    </p>
    <p>
      You can find me on <a href="https://github.com/CrossfireAUT">GitHub</a>.
    </p>
    <h2>Scope</h2>
    <p>
      Everything here is practical and defensive. Anything offensive is shown only against systems I own
      or am authorized to test.
    </p>
  </div>
</BaseLayout>

<style>
  .wrap { padding-block: 3rem 0; }
</style>
