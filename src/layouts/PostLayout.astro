---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import type { Post } from '../lib/posts';
import { readingTime } from '../lib/posts';

interface Props {
  post: Post;
  headings?: MarkdownHeading[];
}
const { post, headings = [] } = Astro.props;

// Table of contents from the post's main headings; only worth showing on longer posts
const tocItems = headings.filter((h) => h.depth === 2);
const showToc = tocItems.length >= 3;
const { title, description, pubDate, updatedDate, tags, severity, cve, cover, coverAlt } = post.data;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description} type="article" image={cover} imageAlt={coverAlt || title}>
  <article class="container">
    <header class="head">
      <div class="meta mono">
        <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        <span>· {readingTime(post.body ?? '')} min read</span>
        {severity && <span class={`badge ${severity}`}>{severity}</span>}
        {cve && <span>{cve}</span>}
      </div>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {updatedDate && <p class="mono updated">Updated {fmt(updatedDate)}</p>}
    </header>
    {cover && (
      <figure class="cover">
        <Image src={cover} alt={coverAlt} widths={[640, 1200]} sizes="(min-width: 768px) 44rem, 100vw" loading="eager" />
      </figure>
    )}
    <div class="post-body">
      {showToc && (
        <nav class="toc" aria-label="Contents">
          <details>
            <summary class="mono">Contents</summary>
            <ol>
              {tocItems.map((h) => (
                <li><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ol>
          </details>
        </nav>
      )}
      <div class="prose">
        <slot />
      </div>
      {showToc && (
        <aside class="toc-rail">
          <nav aria-label="Contents">
            <p class="rail-label mono">Contents</p>
            <ol>
              {tocItems.map((h) => (
                <li><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ol>
          </nav>
        </aside>
      )}
    </div>
    {tags.length > 0 && (
      <footer class="tags">
        {tags.map((t) => <span class="tag">#{t}</span>)}
      </footer>
    )}
  </article>
</BaseLayout>

<script>
  const COPY_ICON =
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
  const CHECK_ICON =
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';

  document.querySelectorAll<HTMLPreElement>('.prose pre.astro-code').forEach((pre) => {
    const lang = pre.dataset.language && pre.dataset.language !== 'plaintext' ? pre.dataset.language : 'text';
    const lines = pre.querySelectorAll('.line').length;

    const wrapper = document.createElement('div');
    wrapper.className = 'code-block' + (lines > 4 ? ' numbered' : '');

    const head = document.createElement('div');
    head.className = 'code-head';
    const label = document.createElement('span');
    label.className = 'code-lang';
    label.textContent = lang;
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-copy';
    button.innerHTML = `${COPY_ICON}<span>Copy</span>`;
    button.setAttribute('aria-label', `Copy ${lang} code`);

    let timer: number | undefined;
    button.addEventListener('click', async () => {
      const text = [...pre.querySelectorAll('.line')].map((l) => l.textContent ?? '').join('\n');
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return;
      }
      button.dataset.copied = 'true';
      button.innerHTML = `${CHECK_ICON}<span>Copied</span>`;
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        delete button.dataset.copied;
        button.innerHTML = `${COPY_ICON}<span>Copy</span>`;
      }, 1800);
    });

    head.append(label, button);
    pre.replaceWith(wrapper);
    wrapper.append(head, pre);
  });

  // Highlight the section currently being read in the side rail
  const railLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc-rail a')];
  const sections = railLinks
    .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length > 0) {
    let ticking = false;
    const update = () => {
      ticking = false;
      // The last heading that has scrolled past the top area counts as current
      let current = -1;
      sections.forEach((s, i) => {
        if (s.getBoundingClientRect().top <= 140) current = i;
      });
      // At the very bottom, the last section is current even if its heading can't reach the top
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
        current = sections.length - 1;
      }
      railLinks.forEach((a, i) => a.setAttribute('aria-current', String(i === current)));
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    update();
  }
</script>

<style>
  article { padding-block: 3rem 1rem; }
  .head { max-width: var(--prose); margin: 0 auto 2.5rem; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; font-size: 0.82rem; color: var(--muted); }
  h1 { font-size: clamp(2rem, 5vw, 2.8rem); margin: 0.8rem 0; }
  .lede { font-size: 1.2rem; color: var(--muted); margin: 0; }
  .updated { font-size: 0.8rem; color: var(--muted); }
  .cover { max-width: var(--prose); margin: 0 auto 2.5rem; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
  .cover :global(img) { display: block; width: 100%; height: auto; }
  .tags { max-width: var(--prose); margin: 3rem auto 0; display: flex; gap: 0.4rem; flex-wrap: wrap; }

  .toc {
    max-width: var(--prose); margin: 0 auto 2.5rem;
    border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface);
  }
  .toc summary {
    display: flex; justify-content: space-between; align-items: center;
    padding: 0.85rem 1.1rem; cursor: pointer; list-style: none;
    font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted);
  }
  .toc summary::-webkit-details-marker { display: none; }
  .toc summary::after { content: '+'; font-size: 1rem; color: var(--accent); }
  .toc details[open] summary::after { content: '−'; }
  .toc summary:hover { color: var(--text); }
  .toc ol { list-style: none; margin: 0; padding: 0.75rem 1.1rem 1rem; border-top: 1px solid var(--border); }
  .toc li { padding: 0.22rem 0 0.22rem 0.75rem; line-height: 1.4; border-left: 2px solid var(--accent-soft); }
  .toc a { color: var(--muted); text-decoration: none; }
  .toc a:hover { color: var(--text); }

  /* Side rail: only on screens wide enough to keep the article centred */
  .toc-rail { display: none; }

  @media (min-width: 75rem) {
    .post-body {
      display: grid;
      grid-template-columns: 1fr minmax(0, var(--prose)) 1fr;
      column-gap: 2.5rem;
    }
    .post-body > .toc { display: none; }
    .post-body > .prose { grid-column: 2; grid-row: 1; margin: 0; max-width: none; }
    .toc-rail { display: block; grid-column: 3; grid-row: 1; max-width: 15rem; }
    .toc-rail nav {
      position: sticky; top: 5.5rem;
      max-height: calc(100vh - 7rem); overflow-y: auto;
      scrollbar-width: thin; scrollbar-color: var(--border) transparent;
    }
    .rail-label {
      margin: 0 0 0.75rem; font-size: 0.72rem;
      letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted);
    }
    .toc-rail ol { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--border); }
    .toc-rail li { margin: 0; }
    .toc-rail a {
      display: block; margin-left: -1px; padding: 0.3rem 0 0.3rem 0.85rem;
      border-left: 2px solid transparent;
      font-size: 0.85rem; line-height: 1.35; color: var(--muted); text-decoration: none;
      transition: color 0.15s, border-color 0.15s;
    }
    .toc-rail a:hover { color: var(--text); }
    .toc-rail a[aria-current='true'] { color: var(--text); border-left-color: var(--accent); }
  }
</style>
